<Window x:Class="AudioWavePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AudioWavePlayer.Controls"
        Title="AudioWave Player"
        Width="1180"
        Height="720"
        MinWidth="920"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        Background="{Binding WindowBackground, RelativeSource={RelativeSource Self}}">
  <Window.Resources>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource IconButton}" />
    <Style x:Key="MediaButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="FlatIconButton" TargetType="Button" BasedOn="{StaticResource MediaButton}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BrowserColumnHeader" TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="{Binding TopBarBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Foreground" Value="{Binding SecondaryText, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="BorderBrush" Value="{Binding WaveShellBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Border x:Name="Header"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Grid>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
                <Thumb x:Name="PART_HeaderGripper"
                       Width="4"
                       HorizontalAlignment="Right"
                       Cursor="SizeWE"
                       Background="Transparent">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Width="1"
                              HorizontalAlignment="Right"
                              Background="#343b45" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Header" Property="Background" Value="#252b33" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Header" Property="Background" Value="#303740" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BrowserTreeItem" TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{Binding PrimaryText, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Padding" Value="3,2" />
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="Expander"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              ClickMode="Press"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{Binding SecondaryText, RelativeSource={RelativeSource AncestorType=Window}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <TextBlock x:Name="Arrow"
                                 Text="&#xE76C;"
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="9"
                                 Foreground="{TemplateBinding Foreground}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <Border x:Name="Selection"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter x:Name="PART_Header"
                                    ContentSource="Header"
                                    HorizontalAlignment="Stretch" />
                </Border>
              </Grid>
              <ItemsPresenter x:Name="ItemsHost"
                              Margin="18,0,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Selection" Property="Background" Value="#252b33" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Selection" Property="Background" Value="#343b45" />
                <Setter TargetName="Selection" Property="BorderBrush" Value="#4b5664" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TreeViewItem" BasedOn="{StaticResource BrowserTreeItem}" />
    <Style x:Key="BrowserScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BrowserScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Thumb"
                    Margin="2"
                    CornerRadius="7"
                    Background="#3f3f3f" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Thumb" Property="Background" Value="#555555" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Thumb" Property="Background" Value="#666666" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{Binding WaveShellBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Width" Value="10" />
      <Setter Property="MinHeight" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track"
                     IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource BrowserScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource BrowserScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource BrowserScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
              </Trigger>
              <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="Auto" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BrowserSplitter" TargetType="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="{TemplateBinding Background}">
              <Border x:Name="Line"
                      Height="1"
                      VerticalAlignment="Center"
                      Background="#252b33" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Line" Property="Height" Value="2" />
                <Setter TargetName="Line" Property="Background" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BrowserListItem" TargetType="ListViewItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{Binding PrimaryText, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Row"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1">
              <GridViewRowPresenter Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#252b33" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#343b45" />
                <Setter TargetName="Row" Property="BorderBrush" Value="#4b5664" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <HierarchicalDataTemplate x:Key="FolderNodeTemplate" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Margin="2,1">
        <TextBlock Text="{Binding Icon}"
                   FontFamily="Segoe MDL2 Assets"
                   Foreground="{Binding SecondaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="13"
                   Width="20"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding Name}"
                   Foreground="{Binding PrimaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <Grid x:Name="RootLayout">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="WaveRow" Height="*" MinHeight="180" />
      <RowDefinition x:Name="SplitterRow" Height="7" />
      <RowDefinition x:Name="BrowserRow" Height="190" MinHeight="90" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border x:Name="TopHeaderBar" Grid.Row="0" Padding="18,14,18,12" Background="{Binding TopBarBackground, RelativeSource={RelativeSource AncestorType=Window}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding PlaybackStateText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Width="78"
                       VerticalAlignment="Center"
                       TextAlignment="Left" />
            <TextBlock Text="{Binding TrackFileName, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                       Foreground="{Binding PrimaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Border Padding="8,3"
                    Margin="10,0"
                    CornerRadius="3"
                    Background="{StaticResource AccentBrush}"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding TrackFormatBadge, RelativeSource={RelativeSource AncestorType=Window}}"
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="{Binding TrackDurationText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                       Foreground="{Binding SecondaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding TrackFormat, RelativeSource={RelativeSource AncestorType=Window}}"
                     Foreground="{Binding SecondaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                     FontSize="14"
                     Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Width="112" Content="Open" Click="OpenFile_Click" />
          <Button Style="{StaticResource FlatIconButton}" Content="{Binding ThemeButtonIcon, RelativeSource={RelativeSource AncestorType=Window}}" Click="ToggleTheme_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="{Binding WaveShellBackground, RelativeSource={RelativeSource AncestorType=Window}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="74" />
      </Grid.ColumnDefinitions>
      <controls:WaveformControl x:Name="Waveform"
                                Grid.Column="0"
                                Margin="18,18,10,18"
                                Peaks="{Binding Peaks, RelativeSource={RelativeSource AncestorType=Window}}"
                                Progress="{Binding PlaybackProgress, RelativeSource={RelativeSource AncestorType=Window}}"
                                Duration="{Binding TrackDuration, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsPlaying="{Binding IsPlaybackActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsDarkTheme="{Binding IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}"
                                SeekRequested="Waveform_SeekRequested" />
      <Grid Grid.Column="1" Margin="0,18,18,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" ClipToBounds="True">
          <Border Background="{Binding TopBarBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
          <Border VerticalAlignment="Stretch"
                  Background="{StaticResource AccentBrush}"
                  RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
              <ScaleTransform ScaleY="{Binding LeftRmsLevel, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Border.RenderTransform>
          </Border>
          <TextBlock Text="{Binding LeftRmsNumberText, RelativeSource={RelativeSource AncestorType=Window}}"
                     Foreground="White"
                     FontFamily="Consolas"
                     FontSize="10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,15" />
          <TextBlock Text="dB"
                     Foreground="White"
                     FontFamily="Consolas"
                     FontSize="9"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,4" />
        </Grid>
        <Grid Grid.Column="2" ClipToBounds="True">
          <Border Background="{Binding TopBarBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
          <Border VerticalAlignment="Stretch"
                  Background="{StaticResource AccentBrush}"
                  RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
              <ScaleTransform ScaleY="{Binding RightRmsLevel, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Border.RenderTransform>
          </Border>
          <TextBlock Text="{Binding RightRmsNumberText, RelativeSource={RelativeSource AncestorType=Window}}"
                     Foreground="White"
                     FontFamily="Consolas"
                     FontSize="10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,15" />
          <TextBlock Text="dB"
                     Foreground="White"
                     FontFamily="Consolas"
                     FontSize="9"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,4" />
        </Grid>
      </Grid>
    </Grid>

    <GridSplitter Grid.Row="2"
                  Style="{StaticResource BrowserSplitter}"
                  Height="7"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  DragDelta="BrowserSplitter_DragDelta"
                  ShowsPreview="False" />

    <Border Grid.Row="3" Padding="18,0,8,8" Background="{Binding WaveShellBackground, RelativeSource={RelativeSource AncestorType=Window}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="290" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border BorderBrush="{Binding TopBarBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                BorderThickness="1"
                Background="{Binding BottomBarBackground, RelativeSource={RelativeSource AncestorType=Window}}">
          <TreeView x:Name="FolderTree"
                    ItemsSource="{Binding FolderNodes, RelativeSource={RelativeSource AncestorType=Window}}"
                    ItemTemplate="{StaticResource FolderNodeTemplate}"
                    ItemContainerStyle="{StaticResource BrowserTreeItem}"
                    SelectedItemChanged="FolderTree_SelectedItemChanged"
                    TreeViewItem.Expanded="FolderTreeItem_Expanded"
                    Background="{Binding BottomBarBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{Binding PrimaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderThickness="0"
                    Padding="6"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Border>

        <Border Grid.Column="2"
                BorderBrush="{Binding TopBarBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                BorderThickness="1"
                Background="{Binding BottomBarBackground, RelativeSource={RelativeSource AncestorType=Window}}">
          <ListView x:Name="BrowserFileList"
                    ItemsSource="{Binding BrowserFiles, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectionChanged="BrowserFileList_SelectionChanged"
                    Background="{Binding BottomBarBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{Binding PrimaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource BrowserListItem}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
              <GridView ColumnHeaderContainerStyle="{StaticResource BrowserColumnHeader}">
                <GridViewColumn Header="Name" Width="420">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{Binding SecondaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="13"
                                   Width="22"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{Binding PrimaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Format" DisplayMemberBinding="{Binding Format}" Width="82" />
                <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="100" />
                <GridViewColumn Header="Modified" DisplayMemberBinding="{Binding Modified}" Width="150" />
              </GridView>
            </ListView.View>
          </ListView>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="BottomControlsBar" Grid.Row="4" Padding="18,12" Background="{Binding BottomBarBackground, RelativeSource={RelativeSource AncestorType=Window}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource MediaButton}" Content="&#xE777;" Click="Restart_Click" ToolTip="Restart" />
          <Button Style="{StaticResource MediaButton}" Content="{Binding PlayButtonIcon, RelativeSource={RelativeSource AncestorType=Window}}" Click="PlayPause_Click" ToolTip="Play/Pause" />
          <Button Style="{StaticResource MediaButton}" Content="&#xE71A;" Click="Stop_Click" ToolTip="Stop" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding CurrentTime, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{Binding PrimaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontFamily="Consolas"
                       FontSize="18"
                       Margin="0,0,14,0" />
            <TextBlock Grid.Column="2"
                       Text="{Binding TotalTime, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{Binding SecondaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontFamily="Consolas"
                       FontSize="16"
                       Margin="14,0,0,0" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Vol" Foreground="{Binding SecondaryText, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Grid Width="132"
                Height="28"
                Cursor="Hand"
                MouseDown="VolumeBar_MouseDown"
                MouseMove="VolumeBar_MouseMove">
            <Border Background="{Binding WaveShellBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Border HorizontalAlignment="Left"
                    Width="{Binding VolumeFillWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{StaticResource AccentBrush}" />
            <TextBlock Text="{Binding VolumePercentText, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{Binding PrimaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontFamily="Consolas"
                       FontWeight="SemiBold"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="DragDropOverlay"
            Grid.RowSpan="5"
            Visibility="Collapsed"
            Background="#CC0F1115"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="2"
            Panel.ZIndex="20"
            IsHitTestVisible="False">
      <Grid>
        <Border Padding="28,20"
                CornerRadius="6"
                Background="{Binding TopBarBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="&#xE8E5;"
                       FontFamily="Segoe MDL2 Assets"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="34"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10" />
            <TextBlock Text="Drag and drop audio file here"
                       Foreground="{Binding PrimaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="WAV, MP3, M4A, FLAC, OGG"
                       Foreground="{Binding SecondaryText, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
